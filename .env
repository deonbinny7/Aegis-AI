POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_gateway

JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
TOKEN_EXPIRY=1440

# For local development without docker, use localhost
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gateway
# REDIS_URL=redis://localhost:6379/0

# For docker-compose, use the service names
# For local development (and docker overrides), use localhost in canonical config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gateway
REDIS_URL=redis://localhost:6379/0

LOGGING_LEVEL=INFO

# API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
