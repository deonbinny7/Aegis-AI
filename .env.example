# ==============================================================================
# ALTAIR AI GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual configurations.
# Never commit the '.env' file containing real secrets to Git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------

# Database Username
# Required: Yes (default: postgres)
POSTGRES_USER=postgres

# Database Password
# Required: Yes (default: postgres)
# Change to a strong password in production environments.
POSTGRES_PASSWORD=postgres

# Database Name
# Required: Yes (default: ai_gateway)
POSTGRES_DB=ai_gateway

# Connection URL for the async PostgreSQL engine (SQLAlchemy + asyncpg)
# Required: Yes
# For local running without Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gateway
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/ai_gateway
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_gateway

# ------------------------------------------------------------------------------
# 2. CACHE & QUEUE CONFIGURATION (REDIS)
# ------------------------------------------------------------------------------

# Connection URL for Redis
# Required: Yes
# For local running without Docker: redis://localhost:6379/0
# For Docker Compose: redis://db_redis:6379/0
REDIS_URL=redis://db_redis:6379/0

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------

# Secret key used for signing JWT access tokens
# Required: Yes
# Generate a secure string (e.g., using 'openssl rand -hex 32')
JWT_SECRET=super-secret-key-change-in-production-use-strong-random-key

# JWT Signing Algorithm
# Required: Yes (default: HS256)
JWT_ALGORITHM=HS256

# Token expiration time in minutes
# Required: Yes (default: 1440 - 24 hours)
TOKEN_EXPIRY=1440

# ------------------------------------------------------------------------------
# 4. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------

# Minimum log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Required: Yes (default: INFO)
LOGGING_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. LLM PROVIDERS API KEYS (CREDENTIALS)
# ------------------------------------------------------------------------------
# Set the keys for the model providers you intend to use.
# Unused keys can be left blank or omitted.

# Gemini API Key (Google AI Studio)
# Optional (Required if using Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key
# Optional (Required if using Groq models)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key
# Optional (Required if routing through OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Cerebras API Key
# Optional (Required if routing through Cerebras)
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here

# OpenAI API Key
# Optional (Required if using official OpenAI models)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Anthropic API Key
# Optional (Required if using Anthropic Claude models)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
